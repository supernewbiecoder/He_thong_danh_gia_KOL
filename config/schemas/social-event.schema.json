{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kol-platform.local/schemas/social-event.schema.json",
  "title": "SocialEvent",
  "description": "Normalized event published by the collectors to kol.raw.<platform>. Message key = kol_id (keeps all events of one KOL in the same partition, in order). PROPOSAL - agree on it with the collector (Module 2) and stream consumer (Module 3) owners.",
  "type": "object",
  "required": ["event_id", "platform", "event_type", "content_id", "kol_id", "author", "created_at", "ingested_at"],
  "properties": {
    "event_id": { "type": "string", "description": "UUID generated by the collector, used for de-duplication" },
    "platform": { "enum": ["bluesky", "youtube"] },
    "event_type": { "enum": ["post", "comment", "reply", "like", "repost", "follow", "delete"] },
    "content_id": { "type": "string", "description": "Native id on the platform (Bluesky URI, YouTube videoId/commentId)" },
    "parent_id": { "type": ["string", "null"], "description": "Post/video this comment or reply belongs to" },
    "kol_id": { "type": "string", "description": "<platform>:<native account id> of the KOL being evaluated" },
    "author": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "handle": { "type": "string" },
        "display_name": { "type": "string" },
        "followers": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "text": { "type": "string" },
    "hashtags": { "type": "array", "items": { "type": "string" }, "description": "Without the leading #, lowercase" },
    "mentions": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" }, "description": "Native platform tags when available" },
    "default_language": { "type": "string" },
    "category_id": { "type": "string" },
    "root_id": { "type": ["string", "null"], "description": "Bluesky reply.root: the post that started the thread" },
    "cid": { "type": "string", "description": "Bluesky content hash; changes when an author edits a post" },
    "rev": { "type": "string", "description": "Bluesky repository revision" },
    "links": { "type": "array", "items": { "type": "string" }, "description": "URLs found in facets" },
    "facets": {
      "type": "array",
      "description": "Platform-provided rich-text features (correct offsets, unlike regex parsing)",
      "items": {
        "type": "object",
        "properties": {
          "type": { "enum": ["mention", "link", "tag"] },
          "value": { "type": "string" }
        }
      }
    },
    "media": {
      "type": "array",
      "description": "Attachments: images, video, external links, quoted posts, thumbnails",
      "items": {
        "type": "object",
        "properties": {
          "type": { "enum": ["image", "video", "link", "quote"] },
          "url": { "type": "string" },
          "alt": { "type": "string" },
          "title": { "type": "string" }
        }
      }
    },
    "topics": { "type": "array", "items": { "type": "string" }, "description": "YouTube topicCategories / topicIds" },
    "content_details": {
      "type": "object",
      "description": "Duration/caption/definition (YouTube contentDetails)",
      "properties": {
        "duration_seconds": { "type": "integer", "minimum": 0 },
        "definition": { "type": "string" },
        "caption": { "type": "boolean" },
        "licensed_content": { "type": "boolean" }
      }
    },
    "live_viewers": { "type": ["integer", "null"], "minimum": 0 },
    "author_videos": { "type": ["integer", "null"], "minimum": 0 },
    "author_total_views": { "type": ["integer", "null"], "minimum": 0 },
    "metrics": {
      "type": "object",
      "description": "Interaction counters at collection time (absent fields = unknown)",
      "properties": {
        "likes": { "type": "integer", "minimum": 0 },
        "shares": { "type": "integer", "minimum": 0 },
        "comments": { "type": "integer", "minimum": 0 },
        "views": { "type": "integer", "minimum": 0 }
      }
    },
    "lang": { "type": "string", "description": "ISO 639-1 if known" },
    "created_at": { "type": "string", "format": "date-time", "description": "When the content was created on the platform (UTC)" },
    "ingested_at": { "type": "string", "format": "date-time", "description": "When the collector received it (UTC)" },
    "source": {
      "type": "object",
      "properties": {
        "collector": { "type": "string" },
        "version": { "type": "string" }
      }
    }
  }
}
