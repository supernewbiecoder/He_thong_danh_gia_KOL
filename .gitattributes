# Files executed inside Linux containers must keep LF line endings,
# even when the repo is checked out on Windows (core.autocrlf=true).
*.sh        text eol=lf
*.conf      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.py        text eol=lf
Dockerfile  text eol=lf
*.md        text
