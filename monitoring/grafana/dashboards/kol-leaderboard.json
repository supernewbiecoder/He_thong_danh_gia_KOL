    {
      "type": "table",
      "title": "Từ khóa và hashtag thịnh hành (15 phút)",
      "id": 10,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "kol-postgres"
      },
      "description": "",
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "kol-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT keyword AS \"Từ khóa\",\n       CASE WHEN is_hashtag THEN 'hashtag' ELSE 'từ khóa' END AS \"Loại\",\n       count AS \"Lượt 15 phút\",\n       unique_kols AS \"Số KOL\",\n       coalesce((platforms->>'bluesky')::int, 0) AS \"Bluesky\",\n       coalesce((platforms->>'youtube')::int, 0) AS \"YouTube\"\nFROM kol.keyword_metrics\nWHERE count > 0 AND updated_at > now() - interval '30 minutes'\nORDER BY count DESC\nLIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Điểm lũy kế của top 5 KOL theo thời gian",
      "id": 11,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "kol-postgres"
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "kol-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT h.bucket AS \"time\",\n       coalesce(s.handle, h.kol_id) AS metric,\n       h.engagement_score AS value\nFROM kol.kol_score_history h\nJOIN kol.kol_scores s USING (kol_id)\nWHERE h.kol_id IN (SELECT kol_id FROM kol.kol_scores ORDER BY engagement_score DESC LIMIT 5)\n  AND $__timeFilter(h.bucket)\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
