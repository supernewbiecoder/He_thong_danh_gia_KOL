    {
      "type": "table",
      "title": "Top KOL toàn thời gian (engagement_score)",
      "id": 7,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "kol-postgres"
      },
      "description": "Điểm lũy kế do Module 3 tính, Module 4 lưu vào kol.kol_scores.",
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "kol-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT coalesce(handle, kol_id) AS \"KOL\",\n       platform AS \"Nền tảng\",\n       followers AS \"Follower\",\n       total_events AS \"Event\",\n       round(engagement_score::numeric, 1) AS \"Điểm lũy kế\",\n       round(window_score::numeric, 1) AS \"Điểm 15 phút\",\n       updated_at AS \"Cập nhật\"\nFROM kol.kol_scores\nORDER BY engagement_score DESC\nLIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "type": "table",
      "title": "KOL đang nổi (15 phút gần nhất)",
      "id": 8,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "kol-postgres"
      },
      "description": "",
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "kol-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT coalesce(handle, kol_id) AS \"KOL\",\n       platform AS \"Nền tảng\",\n       window_events AS \"Event 15 phút\",\n       round(window_score::numeric, 1) AS \"Điểm 15 phút\",\n       round(velocity_per_min::numeric, 2) AS \"Điểm/phút\",\n       array_to_string(top_hashtags, ', ') AS \"Hashtag\"\nFROM kol.kol_scores\nWHERE window_score > 0 AND updated_at > now() - interval '30 minutes'\nORDER BY window_score DESC\nLIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
