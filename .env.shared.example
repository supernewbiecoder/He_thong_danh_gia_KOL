# Template for .env.shared. scripts/shared.sh fills in the host and random passwords on first run.
# .env.shared contains passwords and is ignored by git.

# Full Tailscale name of the host machine. Changing it requires restarting the brokers.
KAFKA_ADVERTISED_HOST=

# Interface the ports are published on. Keep 127.0.0.1: `tailscale serve` forwards to it.
# Do not use 0.0.0.0, it would expose Kafka and Kafka UI (no authentication) to the local network.
BIND_ADDRESS=127.0.0.1

# Passwords for PostgreSQL apply only when its volume is first created.
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_PASSWORD=
POSTGRES_READONLY_PASSWORD=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14

# Kafka -> PostgreSQL writer (db-writer). DATABASE_URL is built by docker-compose.shared.yml
# from POSTGRES_APP_PASSWORD; these only tune throughput and retries.
DB_WRITER_GROUP=postgres-writer
DB_WRITER_BATCH_SIZE=500
DB_WRITER_RETRY_SECONDS=5
LOG_LEVEL=INFO

# ---- Collectors (run on the shared host, writing into the shared Kafka) --------------------
# Without YOUTUBE_API_KEY the collector still runs, but YouTube is skipped and only Bluesky is
# collected. shared.sh copies these values over from .env the first time it creates this file.
COLLECTORS=bluesky,youtube
COLLECTOR_POLL_SECONDS=1800
COLLECTOR_DEDUPE_CACHE=50000
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_IDS=
YOUTUBE_SEARCH_QUERIES=music,technology,football,entertainment,celebrity,politics
YOUTUBE_INCLUDE_COMMENTS=true
YOUTUBE_SEARCH_MAX_PAGES=1
YOUTUBE_SEARCH_INTERVAL_SECONDS=86400
YOUTUBE_MAX_CHANNELS=25
YOUTUBE_RECENT_VIDEOS=5
YOUTUBE_COMMENT_MAX_PAGES=1
YOUTUBE_INCLUDE_REPLIES=false
YOUTUBE_MAX_REPLY_PAGES=1
BLUESKY_MODE=firehose
BLUESKY_FIREHOSE_URL=wss://jetstream1.us-east.bsky.network/subscribe
BLUESKY_COLLECTIONS=app.bsky.feed.post,app.bsky.feed.like,app.bsky.feed.repost,app.bsky.graph.follow
BLUESKY_ENRICH_INTERACTIONS=false
BLUESKY_ENRICH_AUTHORS=true
BLUESKY_AUTHOR_CACHE_SECONDS=3600
BLUESKY_PUBLISH_BATCH=25
BLUESKY_POST_CACHE_SIZE=100000
BLUESKY_RECONNECT_SECONDS=5
BLUESKY_FLUSH_EVERY=500
BLUESKY_FLUSH_SECONDS=5
# Only used when BLUESKY_MODE=poll; the firehose covers the whole network.
BLUESKY_HANDLES=
