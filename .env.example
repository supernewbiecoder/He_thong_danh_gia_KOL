# Copy to .env and adjust. Every value has a default in docker-compose.yml, so .env is optional.

# ---- Kafka ------------------------------------------------------------------
KAFKA_VERSION=3.9.0
# Base64 UUID shared by all KRaft nodes. Changing it requires wiping the volumes (docker compose down -v).
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_HEAP_OPTS=-Xms512m -Xmx512m
KAFKA_MEMORY_LIMIT=1g
# IP/host that clients on OTHER machines use to reach the brokers.
# Keep 127.0.0.1 for local-only use; set the LAN IP (e.g. 192.168.1.20) to share this machine.
# docker-compose.shared.yml overrides this with the Tailscale name via KAFKA_ADVERTISED_HOST.
KAFKA_ADVERTISED_HOST=127.0.0.1

# ---- UIs ----------------------------------------------------------------------
KAFKA_UI_PORT=8080
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=7d
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---- Load test (docker compose --profile loadtest up) -------------------------
LOADGEN_TOPIC=kol.loadtest
LOADGEN_RATE=2000            # msg/s per producer container, 0 = as fast as possible
LOADGEN_DURATION=300         # seconds, 0 = run forever
LOADGEN_PADDING_BYTES=0      # extra bytes per message
LOADGEN_GROUP=loadgen-consumer
LOADGEN_PROCESS_DELAY_MS=0   # simulated CPU work per consumed message

# ---- Collectors (optional profile) ------------------------------------------
COLLECTORS=bluesky,youtube
COLLECTOR_POLL_SECONDS=60
COLLECTOR_HTTP_TIMEOUT=20
COLLECTOR_DEDUPE_CACHE=50000
BLUESKY_HANDLES=
BLUESKY_PASSWORD=
BLUESKY_MODE=firehose
BLUESKY_FIREHOSE_URL=wss://jetstream1.us-east.bsky.network/subscribe
BLUESKY_COLLECTIONS=app.bsky.feed.post,app.bsky.feed.like,app.bsky.feed.repost,app.bsky.graph.follow
BLUESKY_ENRICH_INTERACTIONS=true
# Hydrate handle/display name/follower count for firehose authors (1 call per 25 DIDs).
BLUESKY_ENRICH_AUTHORS=true
BLUESKY_AUTHOR_CACHE_SECONDS=3600
# Author enrichment is batched, so events are published in groups of this size.
BLUESKY_PUBLISH_BATCH=25
BLUESKY_POST_CACHE_SIZE=100000
BLUESKY_RECONNECT_SECONDS=5
# The firehose cursor is written only after Kafka confirmed every message before it,
# in batches of BLUESKY_FLUSH_EVERY events or every BLUESKY_FLUSH_SECONDS.
BLUESKY_FLUSH_EVERY=500
BLUESKY_FLUSH_SECONDS=5
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_IDS=
YOUTUBE_SEARCH_QUERIES=music,technology,football,entertainment,celebrity,politics
YOUTUBE_INCLUDE_COMMENTS=true
YOUTUBE_SEARCH_MAX_PAGES=5
YOUTUBE_COMMENT_MAX_PAGES=5
# Replies cost one extra quota unit per parent comment; keep off unless you need them.
YOUTUBE_INCLUDE_REPLIES=false
YOUTUBE_MAX_REPLY_PAGES=1
YOUTUBE_MAX_PAGES=5

# ---- Stream Processor - Module 3 (docker compose --profile processor up) -----
PROCESSOR_GROUP_ID=stream-processor
PROCESSOR_INPUT_TOPICS=kol.raw.bluesky,kol.raw.youtube
PROCESSOR_SCORES_TOPIC=kol.metrics.kol-scores
PROCESSOR_KEYWORDS_TOPIC=kol.metrics.keywords
PROCESSOR_DLQ_TOPIC=kol.dlq
PROCESSOR_WINDOW_MINUTES=15
PROCESSOR_FLUSH_INTERVAL_SEC=5
